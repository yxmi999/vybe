# Vybe environment template. Copy to .env.local for local dev and fill in what
# you use. Never commit real values (.env* is gitignored except this file).

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
JWT_SECRET=                      # long random string; required in production
ADMIN_EMAILS=                    # comma-separated; unlocks /admin pages
CRON_SECRET=

# ── Database / storage ───────────────────────────────────────────────────────
TURSO_DATABASE_URL=              # unset = local vybe.db file
TURSO_AUTH_TOKEN=
BLOB_READ_WRITE_TOKEN=           # Vercel Blob; unset = public/uploads locally

# ── Card payments: which provider handles NEW checkouts ──────────────────────
# paddle | polar | off. Existing subscribers keep their provider either way.
CARD_PROVIDER=

# ── Paddle Billing ───────────────────────────────────────────────────────────
# Sandbox for local dev, live only in production. `npm run paddle:setup` creates
# the products/prices/webhook/client token and can write these for you.
PADDLE_ENV=sandbox                     # sandbox | production
NEXT_PUBLIC_PADDLE_ENV=sandbox         # must match PADDLE_ENV
PADDLE_API_KEY=                        # pdl_sdbx_… (sandbox) / pdl_live_… (live) — server only
PADDLE_WEBHOOK_SECRET=                 # endpoint_secret_key of the notification destination
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=       # test_… (sandbox) / live_… (live) — public by design
PADDLE_PRICE_CREATOR_MONTHLY=          # pri_…
PADDLE_PRICE_CREATOR_YEARLY=
PADDLE_PRICE_PRO_MONTHLY=
PADDLE_PRICE_PRO_YEARLY=
# Optional
PADDLE_CHECKOUT_URL=                   # override the /pay page URL sent to Paddle
PADDLE_API_BASE=                       # override the API host
PADDLE_WEBHOOK_IP_CHECK=               # "off" disables the Paddle IP allowlist (local tunnels only)

# ── Polar (alternative card provider) ────────────────────────────────────────
POLAR_ENV=sandbox
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_CREATOR_MONTHLY=
POLAR_PRODUCT_CREATOR_YEARLY=
POLAR_PRODUCT_PRO_MONTHLY=
POLAR_PRODUCT_PRO_YEARLY=

# ── Crypto payments (NOWPayments) ────────────────────────────────────────────
# Both keys are required (no IPN secret = payments never confirm, so it stays off).
NOWPAYMENTS_ENV=                       # "sandbox" = api-sandbox.nowpayments.io; empty = live
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# ── Affiliate program (defaults in lib/affiliate.ts / lib/affiliate-safety.ts) ─
AFFILIATE_COMMISSION_PCT=30
AFFILIATE_DURATION_MONTHS=12
AFFILIATE_HOLD_DAYS=30
AFFILIATE_MIN_PAYOUT_USD=25
AFFILIATE_ID_CHECK_USD=600
AFFILIATE_BLOCKED_COUNTRIES=CU,IR,KP,SY,RU,BY

# ── AI ───────────────────────────────────────────────────────────────────────
GOOGLE_GENERATIVE_AI_API_KEY=          # Gemini (AI editor, auto-edit, style copy)
GOOGLE_GENERATIVE_AI_API_KEYS=         # optional comma-separated pool
GROQ_API_KEYS=                         # Whisper subtitles
FAL_KEY=
FAL_IMAGE_MODEL=
FAL_TEXT_MODEL=
AI_GENERATION_ENABLED=false
VIDEO_PROVIDER=
VEO_API_KEY=
VEO_MODEL=
PEXELS_API_KEY=                        # stock B-roll

# ── Email / anti-bot ─────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=

# ── Social sign-in + publishing ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_SCOPES=
# Instagram. Redirect URI = <app url>/api/auth/instagram.
# • New Meta apps (only "API setup with Unified login" offered): use the Meta
#   app ID/secret (App settings → Basic) and set INSTAGRAM_CONFIG_ID to the
#   Facebook Login for Business configuration ID.
# • Older apps with "API setup with Instagram login": use the *Instagram* app
#   ID/secret shown there and leave INSTAGRAM_CONFIG_ID empty.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_CONFIG_ID=
# Optional overrides (defaults: instagram_business_basic,…content_publish,…manage_comments,…manage_insights / v23.0)
INSTAGRAM_SCOPES=
INSTAGRAM_API_VERSION=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=
MOBILE_APP_ORIGIN=
MOBILE_OAUTH_REDIRECT_URL=

# ── Rendering / desktop ──────────────────────────────────────────────────────
RENDER_CONCURRENCY=
VYBE_DATA_DIR=
